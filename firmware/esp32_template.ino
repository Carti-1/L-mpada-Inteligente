String utcTimestamp() {
  const time_t now = time(nullptr);
  if (now < 1700000000) return "";  // NTP time is not ready yet.

  struct tm utc;
  gmtime_r(&now, &utc);
  char value[25];
  strftime(value, sizeof(value), "%Y-%m-%dT%H:%M:%SZ", &utc);
  return String(value);
}

bool sendReading() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi disconnected; reading will be retried later.");
    return false;
  }

  const String timestamp = utcTimestamp();
  if (timestamp.isEmpty()) {
    Serial.println("Waiting for synchronized UTC time.");
    return false;
  }

  JsonDocument reading;
  reading["device_id"] = DEVICE_ID;
  reading["timestamp"] = timestamp;
  reading["tank_level"] = tankLevel;
  reading["temperature"] = temperature;
  reading["humidity"] = humidity;
  reading["luminosity"] = luminosity;
  reading["color"] = color;
  reading["button"] = buttonState;

  String body;
  serializeJson(reading, body);

  HTTPClient http;
  http.setTimeout(5000);
  if (!http.begin(BACKEND_URL)) {
    Serial.println("Could not open BACKEND_URL.");
    return false;
  }
  http.addHeader("Content-Type", "application/json");
  http.addHeader("X-API-Key", API_KEY);
  const int response = http.POST(body);
  http.end();

  if (response != 201) {
    Serial.printf("Reading not stored (HTTP %d); it will be retried later.\n", response);
    return false;
  }
  Serial.println("Reading stored.");
  return true;
}

void setup() {
  Serial.begin(115200);
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
}

void loop() {
  ArduinoCloud.update();
  readSensors();

  const unsigned long now = millis();
  if (now - lastSendMs >= SEND_INTERVAL_MS) {
    lastSendMs = now;
    sendReading();
  }
}
